<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#030712">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>SECRET</title>

  <!-- FIREBASE SDKs COMPAT -->
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Share Tech Mono', monospace; -webkit-tap-highlight-color: transparent; }
    html, body { background: #030712; height: 100vh; width: 100vw; overflow: hidden; color: #00ff66; display: flex; justify-content: center; }

    .app-screen {
      width: 100%;
      max-width: 480px;
      height: 100vh;
      display: flex;
      flex-direction: column;
      background: #030712;
      border-left: 1px solid #00ff6633;
      border-right: 1px solid #00ff6633;
      box-shadow: 0 0 40px rgba(0,255,102,0.05);
    }

    @keyframes neonGlow {
      0%, 100% { color: #00ff66; text-shadow: 0 0 8px #00ff66, 0 0 20px rgba(0, 255, 102, 0.6); opacity: 1; }
      50% { color: #00e5ff; text-shadow: 0 0 12px #00e5ff, 0 0 25px rgba(0, 229, 255, 0.7); opacity: 0.85; }
      70% { opacity: 0.4; }
      72% { opacity: 1; }
    }

    .secret-animated-text {
      font-size: 20px;
      font-weight: bold;
      letter-spacing: 4px;
      display: inline-block;
      animation: neonGlow 3s infinite alternate ease-in-out;
    }

    button, .contact-card, .reaction-pill { transition: all 0.15s ease; }
